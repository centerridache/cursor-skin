{
  "schemaVersion": 1,
  "identity": {
    "id": "ink-minimal",
    "name": "Ink Minimal",
    "version": "1.0.0",
    "author": "cursor-skin",
    "description": "Low-contrast graphite — less chrome, more code.",
    "preview": "preview.jpg",
    "tagline": "Low-contrast graphite — less chrome, more code.",
    "brandSubtitle": "CURSOR SKIN"
  },
  "appearance": {
    "wallpaper": { "type": "image", "src": "wallpaper/main.jpg" },
    "baseTheme": "Cursor Dark",
    "scheme": "dark",
    "paletteId": "graphite",
    "frost": { "enabled": true, "opacity": 0.32, "blur": 12 },
    "effects": { "glow": false, "vignette": false },
    "art": {
      "focusX": 0.75,
      "focusY": 0.45,
      "safeArea": "left",
      "taskMode": "focus"
    }
  },
  "workspace": {
    "sidebar": { "surface": { "opacity": 0.55, "blur": 8 } },
    "editor": { "surface": { "opacity": 0.85, "blur": 2 }, "transparent": false },
    "chat": { "surface": { "opacity": 0.62, "blur": 6 }, "glass": false },
    "auxiliary": { "surface": { "opacity": 0.58, "blur": 8 } },
    "terminal": { "surface": { "opacity": 0.7, "blur": 6 }, "glass": true }
  },
  "performance": { "tier": "lite" }
}
