{
  "name": "cursor-skin",
  "version": "0.3.0",
  "private": true,
  "description": "Open-source Theme Runtime for Cursor (CDP inject, wallpapers, frost UI)",
  "type": "module",
  "scripts": {
    "inject": "node scripts/injector.mjs",
    "verify": "node scripts/injector.mjs --verify",
    "probe": "node scripts/probe-dom.mjs",
    "theme:validate": "node scripts/theme-validate.mjs",
    "test:theme": "node --test theme/validator/validate.test.mjs",
    "test:injector": "node --test scripts/injector-eval.test.mjs scripts/injector-new-document.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
